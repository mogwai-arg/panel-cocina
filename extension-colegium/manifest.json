{
  "manifest_version": 3,
  "name": "Panel de Cocina · Colegium",
  "version": "0.4.3",
  "description": "Mientras usás Colegium, guarda comunicados, horario, asistencia y archivos y los manda a tu Panel de Cocina. No hace pedidos propios a Colegium.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.colegium.cloud/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://app.colegium.cloud/*"],
      "js": ["forma.js", "colegium.js", "captura.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.colegium.cloud/*"],
      "js": ["plantillas.js", "puente.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "opciones.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colegium → Panel"
  }
}
